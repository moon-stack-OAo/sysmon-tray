{
  "name": "sysmon-tray",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "build:exe": "tauri build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const p of ['dist', 'src-tauri/target']) rmSync(p, { recursive: true, force: true });\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "prettier": "^3.9.6",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
